# MultiAgentCom Environment Configuration
# Copy this file to .env and fill in the values before running docker-compose.

# ── Server ──────────────────────────────────────────────
MULTI_AGENT_ADDR=:8080
MULTI_AGENT_SERVICE_NAME=multiagentcom-api
MULTI_AGENT_API_TOKEN=

# ── Auth (JSON array of {tokenHash, actor, roles}) ─────
MULTI_AGENT_AUTH_TOKENS=
# MULTI_AGENT_AUTH_TOKENS_FILE=/run/secrets/auth-tokens.json

# ── Storage ─────────────────────────────────────────────
MULTI_AGENT_STORE_PROVIDER=postgres
MULTI_AGENT_POSTGRES_DSN=postgres://multiagentcom:multiagentcom@postgres:5432/multiagentcom?sslmode=disable
# MULTI_AGENT_STORE_PROVIDER=file
# MULTI_AGENT_DATA_ROOT=/data/state

# ── Runtime Provider ────────────────────────────────────
# Options: local | http | claude | openai | gemini | container
MULTI_AGENT_RUNTIME_PROVIDER=local
MULTI_AGENT_RUNTIME_HTTP_TIMEOUT=60s

# ── Claude API (when RuntimeProvider=claude) ────────────
MULTI_AGENT_RUNTIME_CLAUDE_API_KEY=
MULTI_AGENT_RUNTIME_CLAUDE_MODEL=claude-sonnet-4-20250514
MULTI_AGENT_RUNTIME_CLAUDE_BASE_URL=https://api.anthropic.com
MULTI_AGENT_RUNTIME_CLAUDE_MAX_TOKENS=4096

# ── OpenAI Compatible API (when RuntimeProvider=openai) ─
# Works with OpenAI, Azure OpenAI, Ollama, vLLM, LM Studio, Codex, etc.
# Format: "chat" (default, /v1/chat/completions) or "completions" (legacy Codex, /v1/completions)
MULTI_AGENT_RUNTIME_OPENAI_API_KEY=
MULTI_AGENT_RUNTIME_OPENAI_MODEL=gpt-4o
MULTI_AGENT_RUNTIME_OPENAI_BASE_URL=https://api.openai.com/v1
MULTI_AGENT_RUNTIME_OPENAI_MAX_TOKENS=4096
MULTI_AGENT_RUNTIME_OPENAI_FORMAT=chat

# ── Google Gemini API (when RuntimeProvider=gemini) ─────
MULTI_AGENT_RUNTIME_GEMINI_API_KEY=
MULTI_AGENT_RUNTIME_GEMINI_MODEL=gemini-2.0-flash
MULTI_AGENT_RUNTIME_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
MULTI_AGENT_RUNTIME_GEMINI_MAX_TOKENS=4096

# ── HTTP Runtime (when RuntimeProvider=http) ────────────
MULTI_AGENT_RUNTIME_HTTP_ENDPOINT=
MULTI_AGENT_RUNTIME_HTTP_BEARER_TOKEN=
MULTI_AGENT_RUNTIME_HTTP_MAX_ATTEMPTS=3
MULTI_AGENT_RUNTIME_HTTP_RETRY_BASE_DELAY=200ms

# ── Container Runtime (when RuntimeProvider=container) ──
MULTI_AGENT_RUNTIME_CONTAINER_IMAGE=
MULTI_AGENT_RUNTIME_CONTAINER_BINARY=docker
MULTI_AGENT_RUNTIME_CONTAINER_NETWORK=none
MULTI_AGENT_RUNTIME_CONTAINER_READONLY_ROOTFS=true
MULTI_AGENT_RUNTIME_CONTAINER_MEMORY=512m

# ── Token Cost Tracking ─────────────────────────────────
MULTI_AGENT_TOKEN_PROMPT_PRICE_PER_MILLION=3.0
MULTI_AGENT_TOKEN_OUTPUT_PRICE_PER_MILLION=15.0
MULTI_AGENT_TOKEN_BUDGET_WARN_USD=10
MULTI_AGENT_TOKEN_BUDGET_BLOCK_USD=50

# ── Workspace ───────────────────────────────────────────
MULTI_AGENT_WORKSPACE_PROVIDER=directory

# ── Artifact Storage ───────────────────────────────────
# Options: filesystem (default) | s3
MULTI_AGENT_ARTIFACT_STORE_PROVIDER=filesystem
# S3/MinIO configuration (when ArtifactStoreProvider=s3)
MULTI_AGENT_S3_ENDPOINT=localhost:9000
MULTI_AGENT_S3_ACCESS_KEY=minioadmin
MULTI_AGENT_S3_SECRET_KEY=minioadmin
MULTI_AGENT_S3_BUCKET=multiagentcom
MULTI_AGENT_S3_REGION=us-east-1
MULTI_AGENT_S3_USE_SSL=false

# ── Alert Webhook ───────────────────────────────────────
MULTI_AGENT_ALERT_WEBHOOK_URL=

# ── CORS ────────────────────────────────────────────────
# Comma-separated allowed origins. Leave empty to deny all cross-origin requests.
# Examples: "https://app.example.com,https://admin.example.com" or "*" (not recommended)
MULTI_AGENT_CORS_ALLOWED_ORIGINS=

# ── OIDC / OAuth2 (optional) ───────────────────────────
MULTI_AGENT_OIDC_ISSUER=
MULTI_AGENT_OIDC_CLIENT_ID=
MULTI_AGENT_OIDC_CLIENT_SECRET=
MULTI_AGENT_OIDC_REDIRECT_URL=

# ── Docker Compose Ports ────────────────────────────────
POSTGRES_PORT=5432
REDIS_PORT=6379
